# systemd service that runs the nightly ClamAV scan (clamav-nightly-scan.sh).
# Installed by setup-clamav-fedora.sh as /etc/systemd/system/clamav-nightly-scan.service.
[Unit]
Description=Trigger multi-threaded ClamAV system scan
# clamd@scan is Fedora's daemon; clamav-daemon is Debian/Ubuntu's. Missing ones are ignored.
Wants=clamd@scan.service clamav-daemon.service
After=clamd@scan.service clamav-daemon.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/clamav-nightly-scan.sh
Nice=10
IOSchedulingClass=idle
